[gd_resource type="Resource" script_class="FishingSpotData" load_steps=15 format=3]

[ext_resource type="Script" path="res://scripts/database/fishing_spot_data.gd" id="1_spot"]
[ext_resource type="Script" path="res://scripts/fish_spawn_entry.gd" id="2_spawn"]
[ext_resource type="Resource" path="res://data/bof4/fish/flying_fish.tres" id="3_fish"]
[ext_resource type="Resource" path="res://data/bof4/fish/sea_bass.tres" id="4_fish"]
[ext_resource type="Resource" path="res://data/bof4/fish/flatfish.tres" id="5_fish"]
[ext_resource type="Resource" path="res://data/bof4/fish/octopus.tres" id="6_fish"]
[ext_resource type="Resource" path="res://data/bof4/fish/bonito.tres" id="7_fish"]
[ext_resource type="Resource" path="res://data/bof4/fish/angler.tres" id="8_fish"]

[sub_resource type="Resource" id="FishSpawnEntry_1"]
script = ExtResource("2_spawn")
fish = ExtResource("3_fish")
weight = 25.0

[sub_resource type="Resource" id="FishSpawnEntry_2"]
script = ExtResource("2_spawn")
fish = ExtResource("4_fish")
weight = 30.0

[sub_resource type="Resource" id="FishSpawnEntry_3"]
script = ExtResource("2_spawn")
fish = ExtResource("5_fish")
weight = 18.0

[sub_resource type="Resource" id="FishSpawnEntry_4"]
script = ExtResource("2_spawn")
fish = ExtResource("6_fish")
weight = 12.0

[sub_resource type="Resource" id="FishSpawnEntry_5"]
script = ExtResource("2_spawn")
fish = ExtResource("7_fish")
weight = 10.0

[sub_resource type="Resource" id="FishSpawnEntry_6"]
script = ExtResource("2_spawn")
fish = ExtResource("8_fish")
weight = 5.0

[resource]
script = ExtResource("1_spot")
spot_id = &"ocean_3"
spot_name = "Ocean 3"
location_description = "Between Highway and Mountain Path"
fish_population = Array[ExtResource("2_spawn")]([SubResource("FishSpawnEntry_1"), SubResource("FishSpawnEntry_2"), SubResource("FishSpawnEntry_3"), SubResource("FishSpawnEntry_4"), SubResource("FishSpawnEntry_5"), SubResource("FishSpawnEntry_6")])
depth_notes = "Deep ocean population including Angler."
