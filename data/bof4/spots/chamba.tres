[gd_resource type="Resource" script_class="FishingSpotData" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/database/fishing_spot_data.gd" id="1_spot"]
[ext_resource type="Script" path="res://scripts/fish_spawn_entry.gd" id="2_spawn"]
[ext_resource type="Resource" path="res://data/bof4/fish/jellyfish.tres" id="3_fish"]
[ext_resource type="Resource" path="res://data/bof4/fish/bullcat.tres" id="4_fish"]
[ext_resource type="Resource" path="res://data/bof4/fish/acheron.tres" id="5_fish"]

[sub_resource type="Resource" id="FishSpawnEntry_1"]
script = ExtResource("2_spawn")
fish = ExtResource("3_fish")
weight = 50.0

[sub_resource type="Resource" id="FishSpawnEntry_2"]
script = ExtResource("2_spawn")
fish = ExtResource("4_fish")
weight = 40.0

[sub_resource type="Resource" id="FishSpawnEntry_3"]
script = ExtResource("2_spawn")
fish = ExtResource("5_fish")
weight = 10.0

[resource]
script = ExtResource("1_spot")
spot_id = &"chamba"
spot_name = "Chamba"
location_description = "Southeast of Chamba"
fish_population = Array[ExtResource("2_spawn")]([SubResource("FishSpawnEntry_1"), SubResource("FishSpawnEntry_2"), SubResource("FishSpawnEntry_3")])
depth_notes = "Special Chamba population."
