[gd_resource type="Resource" script_class="FishingSpotData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/database/fishing_spot_data.gd" id="1_spot"]

[resource]
script = ExtResource("1_spot")
spot_id = &"river_3"
spot_name = "River 3"
location_description = "Southwest of the Tomb"
fish_ids = PackedStringArray("sweetfish", "browntail", "trout", "rainbow_trout", "bullcat", "salmon", "sturgeon")
unresolved_fish_names = PackedStringArray()
depth_notes = "Large river population including Sturgeon."
