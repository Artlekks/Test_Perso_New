[gd_resource type="Resource" script_class="FishingSpotData" load_steps=11 format=3]

[ext_resource type="Script" path="res://scripts/database/fishing_spot_data.gd" id="1_spot"]
[ext_resource type="Script" path="res://scripts/fish_spawn_entry.gd" id="2_spawn"]
[ext_resource type="Resource" path="res://data/bof4/fish/man_o_war.tres" id="3_fish"]
[ext_resource type="Resource" path="res://data/bof4/fish/flying_fish.tres" id="4_fish"]
[ext_resource type="Resource" path="res://data/bof4/fish/blowfish.tres" id="5_fish"]
[ext_resource type="Resource" path="res://data/bof4/fish/sea_bream.tres" id="6_fish"]

[sub_resource type="Resource" id="FishSpawnEntry_1"]
script = ExtResource("2_spawn")
fish = ExtResource("3_fish")
weight = 1.0

[sub_resource type="Resource" id="FishSpawnEntry_2"]
script = ExtResource("2_spawn")
fish = ExtResource("4_fish")
weight = 1.0

[sub_resource type="Resource" id="FishSpawnEntry_3"]
script = ExtResource("2_spawn")
fish = ExtResource("5_fish")
weight = 1.0

[sub_resource type="Resource" id="FishSpawnEntry_4"]
script = ExtResource("2_spawn")
fish = ExtResource("6_fish")
weight = 1.0

[resource]
script = ExtResource("1_spot")
spot_id = &"ocean_1"
spot_name = "Ocean 1"
location_description = "Between Shyde and Ludia"
fish_population = Array[ExtResource("2_spawn")]([SubResource("FishSpawnEntry_1"), SubResource("FishSpawnEntry_2"), SubResource("FishSpawnEntry_3"), SubResource("FishSpawnEntry_4")])
depth_notes = "First ocean population."
