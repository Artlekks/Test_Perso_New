[gd_resource type="Resource" script_class="FishingSpotData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/database/fishing_spot_data.gd" id="1_spot"]

[resource]
script = ExtResource("1_spot")
spot_id = &"ocean_2"
spot_name = "Ocean 2"
location_description = "Northeast world map / Salt Sea"
fish_ids = PackedStringArray("man_o_war", "sea_bass", "flatfish", "octopus", "bonito", "spearfish", "whale")
unresolved_fish_names = PackedStringArray()
depth_notes = "Deep ocean population including Spearfish and Whale."
