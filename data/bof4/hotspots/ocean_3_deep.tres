[gd_resource type="Resource" script_class="FishingHotspotDefinition" format=3]

[ext_resource type="Script" path="res://scripts/database/fishing_hotspot_definition.gd" id="1_hotspot"]

[resource]
script = ExtResource("1_hotspot")
hotspot_id = &"ocean_3_deep"
