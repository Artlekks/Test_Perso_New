[gd_resource type="Resource" script_class="FishingMasteryTechniqueDefinition" format=3]
[ext_resource type="Script" path="res://scripts/mastery/fishing_mastery_technique_definition.gd" id="1"]
[resource]
script = ExtResource("1")
technique_id = &"tide_sense"
display_name = "Tide Sense"
category = &"observation"
description = "Read coastal water level and tidal movement to predict changing current, productive water, feeding movement and species depth."
