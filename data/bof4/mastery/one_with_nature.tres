[gd_resource type="Resource" script_class="FishingMasteryTechniqueDefinition" format=3]

[ext_resource type="Script" path="res://scripts/mastery/fishing_mastery_technique_definition.gd" id="1"]

[resource]
script = ExtResource("1")
technique_id = &"one_with_nature"
display_name = "One With Nature"
category = &"fieldcraft"
description = "Settle into the bank, read the water, and present the lure naturally enough that even highly wary fish become more willing to investigate."
teacher_id = &"master_nature_guide"
prerequisite_ids = PackedStringArray("quiet_approach", "read_fish_sign")
capability_tags = PackedStringArray("one_with_nature")
