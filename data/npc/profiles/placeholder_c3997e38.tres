directional_animation_prefixes = {"idle": ""}
directional_aliases = {"idle": {"E": {"animation": "pose_000", "flip_h": false}, "SE": {"animation": "pose_001", "flip_h": false}, "N": {"animation": "pose_002", "flip_h": false}, "S": {"animation": "pose_003", "flip_h": false}, "NE": {"animation": "pose_004", "flip_h": false}, "W": {"animation": "pose_000", "flip_h": true}, "NW": {"animation": "pose_004", "flip_h": true}, "SW": {"animation": "pose_001", "flip_h": true}}}
