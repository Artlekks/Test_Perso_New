[gd_resource type="Resource" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/beach_crafting_recipe.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
recipe_id = &"beach_surface"
display_name = "Beach Surface Lure"
description = "A light surface lure that favors buoyancy and quick handling."
